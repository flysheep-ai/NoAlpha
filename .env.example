# Copy to .env and fill in. .env is gitignored; this file is not.
#
#   cp .env.example .env
#
# Precedence, highest first:
#   1. .cache/api/credentials.json  (set at runtime in the Settings UI)
#   2. exported shell environment variables
#   3. this .env file
#
# Everything here is optional. With no keys the system runs in deterministic
# mode and says so — it never silently pretends an LLM was involved.

# ── LLM (optional; enables the research layer) ────────────────────────────────
# Any OpenAI-compatible endpoint works.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
# Optional: a separate (usually cheaper) model for the trading research loop.
LLM_TRADING_MODEL=
LLM_TIMEOUT=60
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.3

# ── Market data (optional) ────────────────────────────────────────────────────
# US equity daily bars via marketdata.app. A-share data uses public endpoints
# and needs no token.
MARKETDATA_APP_TOKEN=

# ── Server ────────────────────────────────────────────────────────────────────
NOALPHA_API_PORT=8000
NOALPHA_API_STATE_DIR=.cache/api
# Leave empty for frictionless local desktop use. If set, every mutating and
# broker endpoint requires `Authorization: Bearer <token>`. Set this before
# exposing the API on any non-loopback interface.
NOALPHA_ADMIN_TOKEN=
